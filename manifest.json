{
  "manifest_version": 3,
  "name": "3SVerse Etsy Tools",
  "short_name": "Etsy Tools",
  "version": "2.0.0",
  "description": "Open-source Etsy research suite: keywords, products, shops, listing audits, tags, profit and tracking.",
  "author": "3SVerse",
  "homepage_url": "https://github.com/abaduchanna/3SVerse_Etsy_Tools",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://members.erank.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/*"
      ],
      "js": [
        "src/content-scripts/etsy-search-extractor.js",
        "src/content-scripts/etsy-listing-extractor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://members.erank.com/*"
      ],
      "js": [
        "src/content-scripts/erank-keyword-extractor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "3SVerse Etsy Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
